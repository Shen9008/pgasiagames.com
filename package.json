{
  "name": "pgasiagames.com",
  "private": true,
  "description": "Static site + optional Strapi blog sync (see steps.md)",
  "scripts": {
    "sync": "node scripts/content-sync.js",
    "sync:all": "node scripts/content-sync.js --all",
    "sync:daily": "node scripts/content-sync.js --daily",
    "sync:refresh": "node scripts/content-sync.js --refresh",
    "sync:force": "node scripts/content-sync.js --force",
    "sync:doctor": "node scripts/sync-doctor.js",
    "backfill": "node scripts/backfill-internal-links.js",
    "backfill:force": "node scripts/backfill-internal-links.js --force",
    "audit:links": "node scripts/audit-internal-links.js",
    "build:webp": "node scripts/build-assets-webp.mjs && node scripts/patch-html-img-webp.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "sharp": "^0.34.5",
    "wrangler": "^4.88.0"
  }
}
